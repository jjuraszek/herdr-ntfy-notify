# ntfy topic to publish to. The topic name is the only secret on the public
# ntfy.sh server - anyone who knows it can subscribe and publish. Use a long,
# unguessable name (e.g. `herdr-<random>`), or self-host / use access tokens.
NTFY_TOPIC=

# Optional. Defaults to https://ntfy.sh. Set to your self-hosted server if you have one.
NTFY_SERVER=https://ntfy.sh

# Optional. Bearer token for servers with access control enabled (ntfy token auth).
NTFY_TOKEN=

# Optional. Set to 0, false, no, or off to default-disabled without unlinking the plugin.
# The toggle action writes a local state file that overrides this default.
HERDR_NTFY_ENABLED=1

# Optional. The toggle action sets this terminal title while notifications are enabled.
HERDR_NTFY_SET_TITLE=1
HERDR_NTFY_TITLE=ntfy on
